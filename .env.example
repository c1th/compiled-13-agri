# Copy to .env. The Claude key never reaches the browser — server.js reads
# it and proxies /api/analyze. Without a key, the app falls back to a mock
# analysis so the demo still works.
ANTHROPIC_API_KEY=
PORT=3000

# Supplier sourcing for /api/purchase (real product listings + prices).
# Server-side only; leave blank to fall back to indicative estimates.
CHANNEL3_API_KEY=
